# Non-secret settings. This file is sourced by bootstrap.sh.
GITHUB_OWNER="${GITHUB_OWNER:-LionZXYOrg}"
GITHUB_REPOSITORY="${GITHUB_REPOSITORY:-infra}"
SECRETS_GITHUB_OWNER="${SECRETS_GITHUB_OWNER:-LionZXYOrg}"
SECRETS_GITHUB_REPOSITORY="${SECRETS_GITHUB_REPOSITORY:-infra-secrets}"
# Empty means the repository's default branch from the GitHub API.
GITHUB_BRANCH="${GITHUB_BRANCH:-}"
SERVER_IP="${SERVER_IP:-192.168.1.150}"
NODE_NAME="home-1"
